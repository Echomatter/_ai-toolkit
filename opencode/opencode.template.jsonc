{
  "$schema": "https://opencode.ai/config.json",

  // Generated by scripts/refresh-routing.ps1 for terminal launches through the toolkit.
  // OpenCode Desktop loads the toolkit's global Build/Deep/Review agent files directly.
  "model": "__ROUTINE_MODEL__",
  "small_model": "__ROUTINE_MODEL__",
  "default_agent": "build",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": true,

  "instructions": ["../global/WORKSTYLE.md"],

  __LOCAL_PROVIDER_BLOCK__

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "target/**",
      ".venv/**",
      "venv/**",
      ".git/**",
      ".runtime/**"
    ]
  },

  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "lsp": "allow",
    "skill": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "external_directory": "ask",
    "doom_loop": "ask"
  }
}
