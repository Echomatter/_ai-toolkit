{
  "$schema": "https://opencode.ai/config.json",

  // Generated by scripts/refresh-routing.ps1 for terminal launches through the toolkit.
  // Does not pin a parent model; the user chooses it. default_agent remains customized Build.
  "default_agent": "build",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": true,

  "instructions": ["../global/WORKSTYLE.md"],
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "target/**",
      ".venv/**",
      "venv/**",
      ".git/**",
      ".runtime/**"
    ]
  }
}
