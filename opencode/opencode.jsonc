{
  "$schema": "https://opencode.ai/config.json",

  // Generated by scripts/refresh-routing.ps1 for terminal launches through the toolkit.
  // OpenCode Desktop loads the toolkit's global Build/Deep/Review agent files directly.
  "model": "opencode/muse-spark-1.3-contributor-free",
  "small_model": "opencode/muse-spark-1.3-contributor-free",
  "default_agent": "build",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": true,

  "instructions": ["../global/WORKSTYLE.md"],

  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 8192
  },

  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**",
      "build/**",
      "target/**",
      ".venv/**",
      "venv/**",
      ".git/**",
      ".runtime/**"
    ]
  }
}
